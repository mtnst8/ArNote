{
  "name": "ArNote",
  "short_name": "ArNote",
  "description": "Tag — you're it. Notes and photos kept in your own Google Drive",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#16181b",
  "theme_color": "#2f6f4f",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [ { "name": "files", "accept": ["image/*", "application/pdf", "video/*", "audio/*", "text/*", "*/*"] } ]
    }
  }
}
